package localapi.desktop

import localapi.proxy.ProxyDefinition
import localapi.proxy.CommunicationHistory
import localapi.proxy.runProxy
import std.concurrent.Task
import std.core.Unit
import std.core.Exception
import ui.Widget
import ui.State
import ui.ViewScope
import ui.Text
import ui.desktop.kit.Input
import ui.Binding
import ui.CrossAlignment
import ui.Column
import ui.Flex
import ui.FlexItem
import ui.MainAlignment
import ui.desktop.kit.Card
import ui.desktop.kit.Tag
import ui.theme.Tone
import ui.theme.Appearance
import ui.desktop.kit.Button
import ui.WidgetRole
import ui.NodeKey

class ProxyDetails implements Widget {
  ProxyEntry entry
  Widget build() { return entry.detail() }
}

class ProxyEntry implements Widget {
  State<Integer> selection
  Integer id
  String name
  String controlUrl
  String localBaseUrl
  Boolean enabled
  Function<Void()> save
  Function<Void()> changed
  Function<Void(ProxyEntry)> remove
  ProxyStatus status = ProxyStatus()
  Boolean stopping = false
  Boolean reconnectPending = false
  Integer generation = 0
  Task<Unit>? task = null
  ViewScope? scope = null
  CommunicationHistory history = CommunicationHistory()

  ProxyEntry(ProxyDefinition definition, State<Integer> selection, Function<Void()> save, Function<Void()> changed, Function<Void(ProxyEntry)> remove) {
    this.selection = selection
    this.id = definition.id this.name = definition.name
    this.controlUrl = definition.controlUrl this.localBaseUrl = definition.localBaseUrl
    this.enabled = definition.enabled this.save = save this.changed = changed this.remove = remove
  }

  ProxyDefinition definition() {
    return ProxyDefinition(id: this.id, name: this.name, controlUrl: this.controlUrl, localBaseUrl: this.localBaseUrl, enabled: this.enabled)
  }

  Void attach(ViewScope owner) {
    this.scope = owner
    if this.enabled { this.connect() }
  }

  Void connect() {
    if this.task != null {
      if this.stopping { this.reconnect() }
      return
    }
    Boolean previous = this.enabled
    try {
      var configuration = this.definition().configuration()
      this.enabled = true
      this.save()
      var scope = this.scope!!
      this.generation = this.generation + 1
      Integer generation = this.generation
      this.status = ProxyStatus(state: ProxyState.Connecting)
      this.task = scope.start<Unit>(() {
        runProxy(configuration: configuration, history: this.history, status: (String state) {
          scope.dispatch(() {
            if this.generation == generation {
              this.status = switch state {
                case "connecting" { break if this.status.state == ProxyState.Reconnecting { this.status } else { ProxyStatus(state: ProxyState.Connecting) } }
                case "relay-connected" { break ProxyStatus(state: ProxyState.Waiting) }
                case "ready" { break ProxyStatus(state: ProxyState.Connected) }
                case _ { break ProxyStatus(state: ProxyState.Reconnecting, detail: state) }
              }
            }
          })
        })
        return Unit.Value
      })
      var termination = this.task!!.termination()!!
      scope.start<Unit>(() {
        termination.await()
        scope.dispatch(() {
          this.task = null
          this.stopping = false
          this.status = ProxyStatus()
          if this.reconnectPending { this.reconnectPending = false this.connect() }
        })
        return Unit.Value
      })
    } catch Exception error { this.enabled = previous this.status = ProxyStatus(state: ProxyState.Failed, detail: error.message) }
  }

  Void connectFromEditor() {
    var owner = this.scope
    if owner != null { owner.dispatch(this.connect) } else { this.connect() }
  }

  Void reconnect() {
    if this.task == null { this.connect() return }
    Boolean previous = this.enabled
    try {
      this.enabled = true
      this.save()
      this.reconnectPending = true
      this.stopping = true
      this.generation = this.generation + 1
      this.status = ProxyStatus(state: ProxyState.Disconnecting)
      this.task?.cancel()
    } catch Exception error { this.enabled = previous this.status = ProxyStatus(state: ProxyState.Failed, detail: error.message) }
  }

  Void disconnect() {
    this.reconnectPending = false
    Boolean previous = this.enabled
    try {
      this.enabled = false
      this.save()
      this.generation = this.generation + 1
      this.stopping = this.task != null
      this.status = ProxyStatus(state: if this.stopping { ProxyState.Disconnecting } else { ProxyState.Disconnected })
      this.task?.cancel()
    } catch Exception error { this.enabled = previous this.status = ProxyStatus(state: ProxyState.Failed, detail: error.message) }
  }

  Void shutdown() { this.reconnectPending = false this.generation = this.generation + 1 this.task?.cancel() }

  Widget build() {
    Boolean selected = this.selection.value == this.id
    return Button(key: NodeKey.Named("proxy-select-" + this.id.toString()),
      text: this.name + "\n" + this.status.label, action: () { this.selection.value = this.id },
      tone: if selected { Tone.Primary } else { Tone.Neutral },
      appearance: if selected { Appearance.Soft } else { Appearance.Plain })
  }

  Widget detail() {
    return Card(sectionGap: 12.0,
      header: Column(gap: 6.0, cross: CrossAlignment.Stretch) {
        if this.task != null { Text(text: this.name, role: WidgetRole.Title) } else {
          Input(key: NodeKey.Named("proxy-name-" + this.id.toString()), placeholder: "代理名称",
            value: Binding<String>(read: () { this.name }, write: (String value) { if this.name != value { this.name = value this.changed() } }),
            submit: () { this.save() })
        }
        Flex(items: [FlexItem(content: Tag(text: this.status.label, tone: this.status.tone))])
      },
      content: Column(gap: 10.0, cross: CrossAlignment.Stretch) {
        Column(gap: 4.0, cross: CrossAlignment.Stretch) {
          Text(text: "中继地址")
          Input(placeholder: "wss://…/ws/relay/…?role=client", value: Binding<String>(read: () { this.controlUrl },
            write: (String value) { if this.controlUrl != value { this.controlUrl = value this.changed() } }), submit: this.connectFromEditor, enabled: this.task == null)
        }
        Column(gap: 4.0, cross: CrossAlignment.Stretch) {
          Text(text: "本地服务地址")
          Input(placeholder: "http://127.0.0.1:54345", value: Binding<String>(read: () { this.localBaseUrl },
            write: (String value) { if this.localBaseUrl != value { this.localBaseUrl = value this.changed() } }), submit: this.connectFromEditor, enabled: this.task == null)
        }
        if this.status.detail != "" { Text(text: this.status.detail, role: WidgetRole.Destructive) }
      },
      bottom: Flex(gap: 8.0, cross: CrossAlignment.Center, items: [
        FlexItem(content: Flex(items: [
          FlexItem(content: Button(text: "删除", action: () { this.remove(this) }, enabled: this.task == null, tone: Tone.Danger, appearance: Appearance.Plain))
        ]), grow: 1.0),
        FlexItem(content: Button(key: NodeKey.Named("proxy-connect-" + this.id.toString()),
          text: if this.task == null { "连接" } else { "断开" },
          action: () {
            if this.task == null { this.connectFromEditor() } else { this.disconnect() }
          },
          enabled: !this.stopping,
          tone: if this.task == null { Tone.Primary } else { Tone.Neutral },
          appearance: if this.task == null { Appearance.Filled } else { Appearance.Outlined }))
      ])
    )
  }
}
