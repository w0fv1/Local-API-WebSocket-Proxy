package localapi.proxy

import std.core.Exception
import std.io.bytes
import std.json.fromJson
import std.json.toJson
import std.time.duration
import std.time.systemClock
import std.websocket.WebSocket
import std.websocket.WebSocketException
import std.websocket.WebSocketFailure

class Session {
  Configuration configuration
  WebSocket socket
  Function<Void(String)> status
  CommunicationHistory history
  Boolean management
  Boolean ready = false
  Long lastPing = 0
  Long lastPong = 0
  List<Peer> peers = []

  Session(Configuration configuration, WebSocket socket, Function<Void(String)> status, CommunicationHistory history, Boolean management = false) {
    this.configuration = configuration this.socket = socket this.status = status
    this.history = history this.management = management
  }

  Void send(Frame message) {
    String text = toJson(value: message)
    this.socket.sendText(text: text, timeout: duration(seconds: 10, nanoseconds: 0))
    if !this.management { this.history.record(direction: "sent", type: message.type, message: text) }
  }

  Void close() {
    for Peer peer : this.peers { peer.close() }
    this.peers = []
    this.socket.close()
  }

  Void run() {
    this.lastPong = systemClock().now().epochSecond()
    this.status("relay-connected")
    this.send(message: frame(type: "agent.hello", session: "", version: 1))
    for true {
      Long now = systemClock().now().epochSecond()
      if now - this.lastPong > 20 { throw Exception(message: "中继心跳超时，正在重新连接") }
      if now - this.lastPing >= 5 {
        this.socket.ping(data: bytes(values: []), timeout: duration(seconds: 5, nanoseconds: 0))
        this.lastPing = now
      }
      try {
        switch this.socket.receive(timeout: duration(seconds: 0, nanoseconds: 20000000)) {
          case Text(String text) {
            var message = fromJson<Frame>(value: text)
            if !this.management { this.history.record(direction: "received", type: message.type, message: text) }
            Peer? selected = null
            for Peer peer : this.peers { if peer.peer == message.session { selected = peer } }
            if message.type == "hello" {
              if message.version != 1 || message.session == "" { throw Exception(message: "unsupported protocol") }
              if selected == null {
                if this.peers.size() >= 16 {
                  this.send(message: frame(type: "error", session: message.session, id: message.id, error: "session capacity exceeded"))
                } else {
                  var created = Peer(configuration: this.configuration, emit: (Frame reply) { this.send(message: reply) },
                    management: this.management, peer: message.session, lastSeen: now)
                  this.peers.add(created)
                  selected = created
                  this.ready = true
                  this.status("ready")
                }
              }
              if selected != null {
                selected.lastSeen = now
                this.send(message: frame(type: "ready", session: selected.peer, version: 1))
              }
            } else if selected != null {
              selected.lastSeen = now
              if message.type == "goodbye" {
                selected.close()
                this.peers = without<Peer>(values: this.peers, target: selected)
              } else {
                Integer requests = 0
                Integer tunnels = 0
                for Peer peer : this.peers {
                  requests = requests + peer.uploads.size() + peer.requests.size() + peer.downloads.size()
                  tunnels = tunnels + peer.tunnels.size()
                }
                if ((message.type == "http.request" && requests >= 16) || (message.type == "ws.open" && tunnels >= 8)) {
                  this.send(message: frame(type: "error", session: message.session, id: message.id, error: "request capacity exceeded"))
                } else { selected.handle(message: message) }
              }
            }
          }
          case Closed(_, _) { return }
          case Binary(_) { throw Exception(message: "expected a protocol frame") }
          case Pong(_) { this.lastPong = now }
        }
      } catch WebSocketException error {
        if error.reason != WebSocketFailure.Timeout { throw error }
      }
      List<Peer> expired = []
      for Peer peer : this.peers {
        if now - peer.lastSeen > 30 { peer.close() expired.add(peer) }
        else { peer.tick() }
      }
      for Peer peer : expired { this.peers = without<Peer>(values: this.peers, target: peer) }
    }
  }
}
