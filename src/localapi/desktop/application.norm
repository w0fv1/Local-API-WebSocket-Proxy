package localapi.desktop

import di.Container
import std.context.currentContext
import std.concurrent.Task
import ui.ViewScope
import localapi.proxy.Configuration
import localapi.proxy.runProxy
import localapi.proxy.ProxyDefinition
import localapi.proxy.ProxySettings
import std.application.applicationDirectory
import std.core.Exception
import std.core.Unit
import std.filesystem.Path
import std.filesystem.FileException
import std.filesystem.FileFailure
import std.filesystem.FileWriteMode
import std.filesystem.openWrite
import std.filesystem.readText
import std.io.TextEncoding
import std.io.encodeText
import std.io.writeAll
import std.io.use
import std.json.fromJson
import std.json.toJson
import ui.desktop.DesktopApp
import ui.Widget
import ui.State
import ui.Text
import ui.desktop.kit.Splitter
import ui.desktop.kit.Button
import ui.Column
import ui.Dock
import ui.Flex
import ui.FlexItem
import ui.MainAlignment
import ui.desktop.kit.App
import ui.theme.ThemeManager
import ui.theme.ThemeDefinition
import ui.theme.Color
import ui.theme.Tone
import ui.theme.Appearance
import ui.Scroll
import ui.ForEach
import ui.NodeKey
import ui.ValueKey
import ui.WidgetRole
import ui.SizeConstraints
import ui.Dimension
import ui.Box
import ui.Insets
import ui.CrossAlignment

class ProxyWindow implements Widget {
  ThemeManager theme
  List<ProxyEntry> entries = []
  ViewScope? owner = null
  State<Integer>? selection = null
  Integer nextId = 1
  Boolean dirty = false
  String status = ""
  StartupToggle startup = StartupToggle()

  Container? management = null
  Task<Unit>? managementLink = null

  Void init() {
    this.owner = currentContext<ViewScope>()!!
    this.selection = this.owner!!.createState<Integer>(0)
    try {
      var saved = fromJson<ProxySettings>(value: readText(path: Path(value: applicationDirectory().value + "/proxy.json"), encoding: TextEncoding.Utf8, maximumBytes: 1048576))
      saved.validate()
      for definition : saved.proxies {
        this.entries.add(this.entry(definition))
        if definition.id >= this.nextId { this.nextId = definition.id + 1 }
      }
    } catch FileException error {
      if error.reason != FileFailure.NotFound { this.status = "读取配置失败：" + error.message }
    } catch Exception error { this.status = "配置无效：" + error.message }
    for entry : this.entries { entry.attach(this.owner!!) }
    if this.entries.size() == 0 { this.add() } else { this.selection!!.value = this.entries[0].id }
    try {
      var settings = fromJson<ManagementSettings>(value: readText(path: Path(value: applicationDirectory().value + "/management.json"), encoding: TextEncoding.Utf8, maximumBytes: 16384))
      var scope = currentContext<ViewScope>()!!
      this.management = startManagement(settings: settings, window: this, scope: scope)
      if settings.controlUrl != "" {
        var relay = Configuration(controlUrl: settings.controlUrl, localBaseUrl: "http://127.0.0.1:" + settings.port.toString())
        relay.validate()
        this.managementLink = scope.start<Unit>(() {
          runProxy(configuration: relay, management: true, status: (String state) {})
          return Unit.Value
        })
      }
    } catch FileException error {
      if error.reason != FileFailure.NotFound { this.status = "管理 API 配置读取失败" }
    } catch Exception error { this.management?.close() this.management = null this.status = "管理 API 启动失败：" + error.message }
  }

  ProxyEntry entry(ProxyDefinition definition) {
    return ProxyEntry(definition: definition, selection: this.selection!!, save: this.save, changed: this.markChanged, remove: this.remove)
  }

  Void dispose() {
    for entry : this.entries { entry.shutdown() }
    this.managementLink?.cancel()
    this.management?.close()
  }

  Void markChanged() { this.dirty = true }

  Void add() {
    this.markChanged()
    var entry = this.entry(ProxyDefinition(id: this.nextId, name: "代理 " + this.nextId.toString(),
      controlUrl: "", localBaseUrl: "http://127.0.0.1:54345", enabled: false))
    entry.attach(this.owner!!)
    this.entries.add(entry)
    this.selection!!.value = this.nextId
    this.nextId = this.nextId + 1
  }

  Void save() {
    var settings = ProxySettings(proxies: [for (entry : this.entries) entry.definition()])
    settings.validate()
    var writer = openWrite(path: Path(value: applicationDirectory().value + "/proxy.json"), mode: FileWriteMode.Replace)
    use<Unit>(resource: writer, body: () {
      writeAll(writer: writer, content: encodeText(text: toJson(value: settings), encoding: TextEncoding.Utf8))
      return Unit.Value
    })
    this.status = ""
    this.dirty = false
  }

  Void remove(ProxyEntry entry) {
    if entry.task != null { return }
    var previous = this.entries
    this.entries = [for (item : this.entries) if (item != entry) item]
    try {
      this.save()
      if this.selection!!.value == entry.id {
        this.selection!!.value = if this.entries.size() > 0 { this.entries[0].id } else { 0 }
      }
    } catch Exception error { this.entries = previous this.status = error.message }
  }

  Widget build() {
    return App(theme: this.theme, stylesheet: "/localapi/desktop/workspace.css", content: Box(
      size: SizeConstraints(width: Dimension.Fill, height: Dimension.Fill),
      padding: Insets(top: 16.0, right: 20.0, bottom: 16.0, left: 20.0), content: Dock(
        top: Box(size: SizeConstraints(width: Dimension.Fill), padding: Insets(bottom: 14.0),
          content: Flex(wrap: true, gap: 10.0, cross: CrossAlignment.Center, items: [
            FlexItem(content: Flex(gap: 12.0, cross: CrossAlignment.Center, items: [
              FlexItem(content: Text(text: "代理连接", role: WidgetRole.Title)),
              FlexItem(content: Button(text: "新增代理", action: this.add)),
              FlexItem(content: this.startup)
            ]), grow: 1.0),
            FlexItem(content: Flex(gap: 8.0, main: MainAlignment.End, items: [
              FlexItem(content: Button(text: "全部连接", action: () { for entry : this.entries { entry.connect() } }, tone: Tone.Neutral, appearance: Appearance.Outlined)),
              FlexItem(content: Button(text: "全部断开", action: () { for entry : this.entries { entry.disconnect() } }, tone: Tone.Neutral, appearance: Appearance.Outlined))
            ]))
          ])),
        center: Splitter(key: NodeKey.Named("proxy-workspace"), dividerPosition: 0.3, children: [
          Scroll(key: NodeKey.Named("proxy-index"), child: Column(gap: 4.0, cross: CrossAlignment.Stretch) {
            ForEach<ProxyEntry>(items: this.entries, identity: (ProxyEntry entry) { ValueKey<Integer>(value: entry.id) }, child: (ProxyEntry entry) { entry })
          }),
          Scroll(key: NodeKey.Named("proxy-detail"), child: Column(cross: CrossAlignment.Stretch) {
            if this.entries.size() == 0 { Text(text: "暂无代理", role: WidgetRole.Muted) }
            ForEach<ProxyEntry>(items: [for (entry : this.entries) if (entry.id == this.selection!!.value) entry],
              identity: (ProxyEntry entry) { ValueKey<Integer>(value: entry.id) },
              child: (ProxyEntry entry) { ProxyDetails(entry: entry) })
          })
        ]),
        bottom: Column(gap: 6.0, cross: CrossAlignment.Stretch) {
          if this.status != "" { Text(text: this.status, role: WidgetRole.Destructive) }
          if this.dirty {
            Flex(main: MainAlignment.End, items: [
              FlexItem(content: Button(text: "保存更改", action: () { try { this.save() } catch Exception error { this.status = error.message } }))
            ])
          }
        }
    )))
  }
}

Void main() {
  var theme = ThemeManager(definition: ThemeDefinition(primary: Color(hex: "#2563EB")))
  try { DesktopApp(title: "Local API WebSocket Proxy", home: ProxyWindow(theme: theme)).run() }
  finally { theme.close() }
}
